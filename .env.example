# ============================================================================
# NIS2 Compliance Platform — Environment Configuration
# ============================================================================
# COPY this file to .env and fill in the values before starting.
#
# P0-07 audit fix (v2.5.5): this file now uses PLACEHOLDER values
# instead of working dev credentials. A bare `cp .env.example .env`
# will NOT produce a bootable stack — you MUST replace the placeholders.
# This is intentional: it prevents accidentally committing real secrets
# and forces explicit configuration on every new checkout.
# ============================================================================

# === Environment ===
# "development" or "production". DEFAULTS TO PRODUCTION — this file is the
# template for a real deployment, so it must fail safe, not fail convenient.
#
# Production mode is what turns on:
#   - JWT_SECRET strength + CORS_ORIGINS allow-list validation (refuses to boot)
#   - the Secure flag on the access / refresh / csrf cookies
#   - the SUPERUSER/BYPASSRLS refusal, so RLS is not decorative
# ...and what turns OFF:
#   - the unauthenticated GET /api/v1/auth/debug/last-email helper
#   - the in-memory email outbox that swallows outbound mail (see SMTP below)
#
# You normally do NOT need to change this line:
#   - `make prod` -> infra/docker/docker-compose.prod.yml pins production
#     per service, which overrides whatever this file says.
#   - `make dev`  -> docker-compose.dev.yml pins development the same way.
# It matters only if you run the API outside compose (systemd, k8s, bare
# uvicorn). In that case: production, unless you are actively developing.
ENVIRONMENT=production

# === Database ===
# `postgres:5432` resolves via Docker DNS inside the compose network.
# For host-side tools (pytest, alembic, REPL) use localhost:5433 instead.
DATABASE_URL=postgresql+asyncpg://nis2:CHANGE_ME_DB_PASSWORD@postgres:5432/nis2
DATABASE_URL_SYNC=postgresql://nis2:CHANGE_ME_DB_PASSWORD@postgres:5432/nis2
POSTGRES_USER=nis2
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=nis2

# === Redis ===
# Production runs `redis-server --requirepass $REDIS_PASSWORD`, so the URL MUST
# embed the same password (userless `:password@host`). Keep it in sync with
# REDIS_PASSWORD below or the stack never goes healthy (Redis returns NOAUTH).
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
# Required by docker-compose.prod.yml (redis-server --requirepass).
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# === JWT ===
# REQUIRED. Generate with: openssl rand -base64 32
# The API refuses to start in production if this is unset or a placeholder.
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Field encryption ===
# Keys field-level encryption of MFA/TOTP secrets (AES-GCM). Independent of
# JWT_SECRET. When unset, the key is derived from JWT_SECRET for backward
# compatibility — fine for HS256. In RS256 mode there is NO JWT_SECRET, so this
# is REQUIRED in production (the API refuses to start without it).
# Generate with: openssl rand -base64 32
# NOTE: changing this on an existing deployment makes already-stored TOTP
# secrets undecryptable — affected users must re-enroll MFA.
DATA_ENCRYPTION_KEY=

# === SMTP (outbound email) ===
# Load-bearing in production. Two user-visible flows depend on it:
#   - password reset  (POST /auth/forgot-password -> the emailed link)
#   - Art. 23 incident-deadline alerts, whose fallback channel is "email the
#     org admins" when no NotificationChannel row exists.
#
# With SMTP_HOST empty:
#   - development -> the message is logged and kept in an in-process outbox,
#     readable via the dev-only debug endpoint. Convenient locally, and the
#     reason the missing config went unnoticed for so long.
#   - production  -> app/utils/email.py raises. The caller catches and logs it,
#     so the API stays up and returns 204, but NO MAIL IS SENT. Users silently
#     never receive their reset link and the 24 h Art. 23 alert never leaves
#     the box. Grep the API logs for "failed to send" to confirm.
#
# Leave SMTP_HOST empty only on a deployment that will never use password reset
# and never rely on incident-deadline alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nis2.yourdomain.com
# STARTTLS on 587 (typical) or implicit TLS on 465. Mutually exclusive.
SMTP_STARTTLS=true
SMTP_SSL=false

# Base URL the password-reset link points at. MUST be your public origin in
# production — the default below emits localhost links that no user can open.
PUBLIC_URL=http://localhost:8077

# DO NOT ENABLE. Development-only helper that mounts
# GET /api/v1/auth/debug/last-email, which returns the most recent outbound
# email -- password-reset link included -- to any caller, unauthenticated.
# Combined with the public /auth/forgot-password endpoint that is a complete
# account-takeover chain against any user on the instance.
#
# It exists so the e2e suite can drive the real reset flow; docker-compose.dev.yml
# and the CI e2e job set it explicitly. The API REFUSES TO START if it is set
# while ENVIRONMENT=production. Leave it empty here.
ENABLE_DEV_EMAIL_DEBUG=false

# === Celery ===
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# === NextAuth ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32

# === API ===
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# === AI remediation (OPTIONAL — off by default) ===
# The "Explain finding" copilot can call a local LLM (Ollama/LM Studio) or
# OpenAI. The local LLM stays on-prem. OpenAI egress is DISABLED unless you set
# ENABLE_OPENAI=true — setting only OPENAI_API_KEY is no longer enough.
# PRIVACY: enabling OpenAI sends finding text (which may contain internal
# hostnames, leaked secrets, incidental PII) to api.openai.com in the USA — a
# transborder flow you must disclose in your privacy notice (docs/privacy.md §7.3).
LLM_API_URL=http://localhost:1234/v1
OPENAI_API_KEY=
ENABLE_OPENAI=false

# === CORS ===
# REQUIRED in production. Comma-separated allow-list, no wildcards.
# Example: CORS_ORIGINS=https://nis2.example.com,https://app.nis2.example.com
CORS_ORIGINS=

# === Caddy (production) ===
DOMAIN=nis2.yourdomain.com
